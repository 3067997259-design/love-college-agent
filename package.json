{
  "name": "love-college-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Love, College & Agent — Windows desktop agent",
  "type": "module",
  "main": "out/main/index.cjs",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.14.0",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "start": "node scripts/run.mjs preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "rebuild:native": "node scripts/run.mjs rebuild",
    "test:electron": "pnpm build && node scripts/smoke-electron.mjs",
    "probe:sqlite": "pnpm build && node scripts/probe-electron.mjs sqlite",
    "setup:electron": "node scripts/run.mjs install-electron",
    "probe:imap": "pnpm build && node scripts/probe-electron.mjs imap",
    "probe:deeptech-audit": "node --experimental-transform-types scripts/probe-deeptech-audit.mjs",
    "experiment:deeptech-memory": "node --experimental-transform-types scripts/experiment-deeptech-memory.mjs",
    "experiment:deeptech-grounding": "node --experimental-transform-types scripts/experiment-deeptech-grounding.mjs",
    "probe:journal": "pnpm build && node scripts/probe-electron.mjs journal",
    "probe:model": "pnpm build && node scripts/probe-electron.mjs model",
    "preview:ui": "node scripts/ui-preview.mjs",
    "shot:ui": "node scripts/ui-shot.mjs",
    "probe:harness": "pnpm build && node scripts/probe-electron.mjs harness",
    "test:harness": "pnpm build && node scripts/smoke-harness.mjs",
    "test:developer": "pnpm build && node scripts/smoke-developer.mjs",
    "package:win": "node scripts/package-win.mjs",
    "test:package": "node scripts/smoke-package.mjs",
    "test:pomodoro": "pnpm build && node scripts/smoke-pomodoro.mjs",
    "test:pomodoro:realtime": "pnpm build && node scripts/smoke-pomodoro.mjs --real-time",
    "probe:pomodoro": "pnpm build && node scripts/probe-electron.mjs pomodoro",
    "probe:campus": "pnpm build && node scripts/probe-electron.mjs campus",
    "test:campus": "pnpm build && node scripts/smoke-campus.mjs",
    "probe:documents": "pnpm build && node scripts/probe-electron.mjs documents",
    "test:documents": "pnpm build && node scripts/smoke-documents.mjs",
    "probe:memory": "pnpm build && node scripts/probe-electron.mjs memory",
    "test:memory": "pnpm build && node scripts/smoke-memory.mjs",
    "test:mcp": "pnpm build && node scripts/smoke-mcp.mjs",
    "probe:mcp:student-hub": "pnpm build && node scripts/probe-electron.mjs mcp-student-hub",
    "probe:backup": "pnpm build && node scripts/probe-electron.mjs backup",
    "test:backup": "pnpm build && node scripts/smoke-backup.mjs",
    "test:model-slots": "pnpm build && node scripts/smoke-model-slots.mjs",
    "test:mini": "pnpm build && node scripts/smoke-mini.mjs",
    "test:onboarding": "pnpm build && node scripts/smoke-onboarding.mjs",
    "test:onboarding:backend": "pnpm build && node scripts/smoke-onboarding.mjs --backend-only",
    "probe:rodin": "pnpm build && node scripts/probe-electron.mjs rodin",
    "test:gifts": "pnpm build && node scripts/smoke-gifts.mjs",
    "probe:heart-flow": "pnpm build && node scripts/probe-electron.mjs heart-flow",
    "probe:life": "pnpm build && node scripts/probe-electron.mjs life",
    "test:life-work": "pnpm build && node scripts/smoke-life-work.mjs",
    "test:room": "pnpm build && node scripts/smoke-room.mjs",
    "test:history": "pnpm build && node scripts/smoke-history.mjs",
    "test:notifications": "pnpm build && node scripts/smoke-notifications.mjs",
    "test:characters": "pnpm build && node scripts/smoke-characters.mjs",
    "test:heart-flow": "pnpm build && node scripts/smoke-heart-flow.mjs"
  },
  "dependencies": {
    "@fontsource/long-cang": "5.3.0",
    "@google/model-viewer": "^4.4.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "better-sqlite3": "13.0.3",
    "imapflow": "2.4.3",
    "jszip": "3.10.2",
    "lxgw-wenkai-screen-web": "1.522.0",
    "mailparser": "3.9.39",
    "pdf-parse": "2.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/mailparser": "3.9.0",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
